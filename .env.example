# Public customer-tracking page base. Not a secret.
# When unset, server.js uses this same default.
PUBLIC_TRACK_BASE_URL=https://track.tulipfleet.com/v

# REQUIRED. JWT imzalama secret'ı — zorunlu, varsayılanı YOKTUR (14.10.2026
# güvenlik taraması: eski sabit fallback kaldırıldı). Tanımsızsa server.js
# process.exit(1) ile başlamayı reddeder. Üretim için:
#   openssl rand -hex 32
JWT_SECRET=
