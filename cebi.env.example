# TulipFleet Customer Edition (Cebi) — env şablonu.
# ADR-CE-03 "Bağımsız Çalışma Zamanı": buradaki HİÇBİR değer ana projeden
# (tulipfleet.com, Hetzner 10.0.0.0/16 private network, mevcut fleet_tracking
# DB, mqtt.tulipfleet.com) kopyalanmamalı/yeniden kullanılmamalı. Her değer
# Cebi'ye özel, yeni ve bağımsız üretilmeli.
#
# Bu dosyayı `cebi.env` olarak kopyala, gerçek değerleri doldur, GİT'E
# COMMIT ETME (.gitignore'da olmalı — kontrol et).

# ── Zorunlu ────────────────────────────────────────────────────────────

# JWT imzalama secret'ı. Ana projenin JWT_SECRET'ı ile AYNI OLMAMALI —
# aynı olursa iki sistem arasında token kenetlenmesi kurulur (ADR-CE-03
# ihlali). Üret: openssl rand -hex 32
JWT_SECRET=

# cebi-db container'ının şifresi (docker-compose.cebi.yml DATABASE_URL'i
# bunu kullanır). Üret: openssl rand -hex 24
CEBI_DB_PASSWORD=

# Opsiyonel override'lar (docker-compose.cebi.yml içinde varsayılanları var)
# CEBI_DB_NAME=cebi_db
# CEBI_DB_USER=cebi_admin
# CEBI_BACKEND_PORT=3100

# ÖNEMLİ — OLAY (2026-10-19): CEBI_DB_PASSWORD/CEBI_DB_USER/CEBI_DB_NAME/
# CEBI_BACKEND_PORT'un bu dosyadaki (cebi.env) değerleri sadece
# cebi-backend CONTAINER'ının runtime env'ini doldurur. docker-compose.cebi.yml
# içindeki ${...} ikameleri (cebi-db servisinin POSTGRES_PASSWORD'ü ve
# cebi-backend'in DATABASE_URL'i) bunu KULLANMAZ — docker compose'un kendi
# değişken ikamesi için, bu dosyayla AYNI dizinde, AYNI değerleri taşıyan
# ayrı bir `.env` dosyası da gerekir (bkz. docker-compose.cebi.yml başlık
# notu). İkisi senkron tutulmalı, ikisi de asla git'e commit edilmez.

PORT=3000

# ── Dış servisler (hepsi YENİ/bağımsız hesaplar olmalı — ana projenin
#    HERE_API_KEY/GOOGLE_MAPS_API_KEY/SMTP hesabı ile paylaşılmamalı) ────

HERE_API_KEY=
HERE_TIMEOUT_MS=4000
ROUTING_PROVIDER=here

# VRP_PROVIDER — Faz A-2 (Dispatcher VRP Optimizasyon Portu). ROUTING_PROVIDER
# ile KARIŞTIRILMAMALI: o tekil A→B rota/trafik (HERE Routing v8) seçer, bu
# "hangi görev hangi araca verilsin" (VRP çözümü) seçer — iki ayrı sorun uzayı
# (bkz. lib/routing/vrpFactory.js başlık yorumu). Opsiyonel, varsayılan "mock".
# "here-tour" (gerçek HERE Tour Planning API) Faz A-3'te (2026-10-19) port
# edildi, aynı HERE_API_KEY'i kullanır (apikey query-param). AÇIK RİSK:
# bu hesabın Tour Planning'e erişim yetkisi henüz canlıda doğrulanmadı
# (bkz. lib/routing/HereTourPlanningProvider.js başlık yorumu); ilk gerçek
# istekte HERE 401/403 dönerse job 'failed' olarak kaydedilir (throw etmez).
# Boş/yoksa mock kullanılır; tanınmayan bir değer (örn. yazım hatası) LOUD
# throw eder, sessizce mock'a düşmez.
VRP_PROVIDER=mock

# §9.7 — OSRM/CARTO kullanılacak (Faz 1 raporu), ana projede kod/entegrasyon
# yok — sıfırdan eklenecek. Şimdilik sadece env iskeleti.
OSRM_BASE_URL=
CARTO_API_KEY=

GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=

# Yeni, Cebi'ye özel bir e-posta hesabı/SMTP gerekir. Domain kararı
# verildi: cebi-api.tulipfleet.com (bkz. FORK_BASELINE.md) — ama bu API
# subdomain'i, e-posta göndereni için ayrı bir karar gerekebilir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── MQTT (ADR-CE-02 henüz "inceleniyor" — HTTPS toplu senkronizasyon ilk
#    sürüm varsayılanı; MQTT kullanılacaksa bu değerler YENİ/bağımsız bir
#    broker'a ait olmalı, mqtt.tulipfleet.com KULLANILMAMALI) ──────────

MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PORT=8883

# ── DÜZELTME (2026-10-19): bu yorum YANLIŞTI — routes/internalBridge.js
#    server.js'de REGISTER EDİLMİŞ ve ZATEN CANLIDA KULLANILIYOR (Dispatcher
#    Faz A-2'nin köprü-adaptasyonu bekleyen kısmı için de gerekecek). Fail-
#    closed: INTERNAL_BRIDGE_TOKEN tanımsızsa /api/internal/bridge/* 503
#    döner. INTERNAL_CORE_API_URL ise gerçekten gereksiz (tek süreç, köprü
#    kendi içinde çağrılacak/çağrılıyor) — SADECE o satır kaldırılmalıydı.
INTERNAL_BRIDGE_TOKEN=
# INTERNAL_CORE_API_URL=        <- gerek yok (tek backend, HTTP self-call değil)

# ── Diğer (ana projeden fonksiyonel olarak taşınan, Cebi'ye özel değer
#    gerektiren) ───────────────────────────────────────────────────────

# API domain kararı verildi (cebi-api.tulipfleet.com, bkz. FORK_BASELINE.md),
# ama public tracking linkleri için ayrı bir subdomain gerekip gerekmediği
# henüz netleşmedi.
PUBLIC_TRACK_BASE_URL=

DEVICE_ACTIVATION_KEY=
FEATURE_TASK_EVENTS=
FUEL_CAP_BLIND_DAYS=
FUEL_CAP_KM_PER_DAY=
